{
  "expo": {
    "name": "Morrowmint",
    "slug": "morrowmint",
    "scheme": "morrowmint",
    "version": "0.1.0",
    "icon": "./assets/brand/app-icon.png",
    "backgroundColor": "#F6F7F2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing",
      ["expo-splash-screen", { "backgroundColor": "#F6F7F2", "image": "./assets/brand/splash-mark.png", "imageWidth": 128, "resizeMode": "contain" }]
    ],
    "android": {
      "package": "app.paisasense.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#163D30"
      },
      "permissions": [
        "android.permission.READ_SMS"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.paisasense.mobile",
      "buildNumber": "1"
    },
    "web": { "favicon": "./assets/brand/favicon.png" }
  }
}
