{
  "expo": {
    "name": "Morrowmint",
    "slug": "morrowmint",
    "scheme": "morrowmint",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-sharing"
    ],
    "android": {
      "package": "app.paisasense.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.READ_SMS"
      ]
    },
    "ios": {
      "bundleIdentifier": "app.paisasense.mobile",
      "buildNumber": "1"
    }
  }
}
