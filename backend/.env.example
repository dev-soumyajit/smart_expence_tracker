# Copy this file to backend/.env. Run Python/Alembic from backend/.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://paisa:paisa-local-only@localhost:5432/paisa
# Neon: copy your connection string and use the psycopg driver, retaining SSL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
SECRET_KEY=replace-with-a-random-secret-of-at-least-40-characters
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
FRONTEND_ORIGINS=http://localhost:3000
# Render production: FRONTEND_ORIGINS=https://morrowmint.devsoumyajit.in
GROQ_API_KEY=
# Verify current availability in your Groq console before enabling.
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=15
# Resend: add your key, verify devsoumyajit.in in Resend, then enable email authentication.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Morrowmint <noreply@devsoumyajit.in>"
EMAIL_AUTH_ENABLED=false
EMAIL_OTP_EXPIRY_SECONDS=600
EMAIL_RESEND_COOLDOWN_SECONDS=60
PORT=8000
